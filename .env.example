# Job Market Radar Environment Variables Example
# Copy this file to .env.local for local overrides

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobmarketradar?schema=public"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# Permitted Job Search APIs & Career Providers
# 1. Remotive API (Public Open Tech API - No key required)
ENABLE_REMOTIVE_PROVIDER="true"

# 2. Arbeitnow API (Public Open Job Board API - No key required)
ENABLE_ARBEITNOW_PROVIDER="true"

# 3. Target Tech Consulting Greenhouse Boards (Public Boards API - No key required)
ENABLE_GREENHOUSE_BOARDS="true"
GREENHOUSE_BOARD_TOKENS="thoughtworks,slalom,contentful,automattic"

# 4. Adzuna Job API (Optional - Register at https://developer.adzuna.com/)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="in" # "in" for India, "us" for USA, "gb" for UK

# 5. RapidAPI JSearch (Optional - Register at https://rapidapi.com/)
RAPIDAPI_KEY=""

# Ingestion Frequency & Cache (in minutes)
JOB_CACHE_TTL_MINUTES="60"
